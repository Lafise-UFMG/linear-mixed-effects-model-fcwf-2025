title = "Ventilatory Equivalent (VE/VO2) vs. VO2 (5s intervals)",
subtitle = "Dashed lines: LV1 (blue), LV2 (red), and VO2pico (green)"
) +
# Include the values of the variables on the x-axis
scale_x_continuous(breaks = c(20, 30, 35, 40, 50, 55, 60, LV1, LV2, VO2pico)) +
theme_bw()
# Plotting VE_VCO2 against VO2_kg
ggplot(dplyr::filter(df_long, Variable == "VE_VCO2"), aes(x = VO2_kg, y = Value)) +
geom_point(color = "black") +
# Add the vertical dashed lines with increased thickness
geom_vline(aes(xintercept = VO2pico), color = "green", linetype = "dashed", linewidth = 1.1) +
geom_vline(aes(xintercept = LV1), color = "blue", linetype = "dashed", linewidth = 1.1) +
geom_vline(aes(xintercept = LV2), color = "red", linetype = "dashed", linewidth = 1.1) +
labs(
x = "VO2",
y = "Ventilatory Equivalent (VE/VCO2)",
title = "Ventilatory Equivalent (VE/VCO2) vs. VO2",
subtitle = "Dashed lines: LV1 (blue), LV2 (red), and VO2pico (green)"
) +
# Include the values of the variables on the x-axis
scale_x_continuous(breaks = c(20, 25, 30, 35, 45, 50, 55, 60, 65, LV1, LV2, VO2pico)) +
theme_bw()
# Plotting VE_VCO2 against VO2_kg
ggplot(dplyr::filter(df_long_agg, Variable == "VE_VCO2_s"), aes(x = VO2_kg_s, y = Value)) +
geom_point(color = "black") +
# Add the vertical dashed lines with increased thickness
geom_vline(aes(xintercept = VO2pico), color = "green", linetype = "dashed", linewidth = 1.1) +
geom_vline(aes(xintercept = LV1), color = "blue", linetype = "dashed", linewidth = 1.1) +
geom_vline(aes(xintercept = LV2), color = "red", linetype = "dashed", linewidth = 1.1) +
labs(
x = "VO2",
y = "Ventilatory Equivalent (VE/VCO2)",
title = "Ventilatory Equivalent (VE/VCO2) vs. VO2 (5s intervals)",
subtitle = "Dashed lines: LV1 (blue), LV2 (red), and VO2pico (green)"
) +
# Include the values of the variables on the x-axis
scale_x_continuous(breaks = c(20, 25, 30, 35, 45, 50, 55, 60, 65, LV1, LV2, VO2pico)) +
theme_bw()
df_aggregated <- df_tratado %>%
# Create a grouping variable based on 5-second intervals.
# The integer division (%/%) groups time points like 0-4.99s, 5-9.99s, etc.
mutate(time_group = floor(t_s / 10)) %>%
# Group the data by this new time group.
group_by(time_group) %>%
# Summarise each group by calculating the average of the key variables.
summarise(
# Use the first value of t_s for the new time variable, as it represents
# the start of the 5-second interval.
t_s = first(t_s),
VO2_kg_s = mean(VO2_kg, na.rm = TRUE),
VCO2_kg_s = mean(VCO2_kg, na.rm = TRUE),
VE_VCO2_s = mean(VE_VCO2, na.rm = TRUE),
VE_VO2_s = mean(VE_VO2, na.rm = TRUE)
) %>%
ungroup()
# Plotting VE_VCO2 against VO2_kg
ggplot(dplyr::filter(df_long_agg, Variable == "VE_VCO2_s"), aes(x = VO2_kg_s, y = Value)) +
geom_point(color = "black") +
# Add the vertical dashed lines with increased thickness
geom_vline(aes(xintercept = VO2pico), color = "green", linetype = "dashed", linewidth = 1.1) +
geom_vline(aes(xintercept = LV1), color = "blue", linetype = "dashed", linewidth = 1.1) +
geom_vline(aes(xintercept = LV2), color = "red", linetype = "dashed", linewidth = 1.1) +
labs(
x = "VO2",
y = "Ventilatory Equivalent (VE/VCO2)",
title = "Ventilatory Equivalent (VE/VCO2) vs. VO2 (5s intervals)",
subtitle = "Dashed lines: LV1 (blue), LV2 (red), and VO2pico (green)"
) +
# Include the values of the variables on the x-axis
scale_x_continuous(breaks = c(20, 25, 30, 35, 45, 50, 55, 60, 65, LV1, LV2, VO2pico)) +
theme_bw()
df_aggregated <- df_tratado %>%
# Create a grouping variable based on 5-second intervals.
# The integer division (%/%) groups time points like 0-4.99s, 5-9.99s, etc.
mutate(time_group = floor(t_s / 10)) %>%
# Group the data by this new time group.
group_by(time_group) %>%
# Summarise each group by calculating the average of the key variables.
summarise(
# Use the first value of t_s for the new time variable, as it represents
# the start of the 5-second interval.
t_s = first(t_s),
VO2_kg_s = mean(VO2_kg, na.rm = TRUE),
VCO2_kg_s = mean(VCO2_kg, na.rm = TRUE),
VE_VCO2_s = mean(VE_VCO2, na.rm = TRUE),
VE_VO2_s = mean(VE_VO2, na.rm = TRUE)
) %>%
ungroup()
#| echo: FALSE
#Preparando os dados
df_long_agg <- df_aggregated %>%
pivot_longer(cols = c("VE_VO2_s", "VE_VCO2_s"), names_to = "Variable", values_to = "Value")
# Plotting VE_VCO2 against VO2_kg
ggplot(dplyr::filter(df_long_agg, Variable == "VE_VCO2_s"), aes(x = VO2_kg_s, y = Value)) +
