# Carregando os dados
df <- read.xlsx("/Users/rafaeltorres/Downloads/Análise VO2max e Limiares - Letícia Silva Castro.xlsx","Dados estruturados") %>%
as_factor()
df_tratado <- df[-1:-1 ,] #elimina primeira linha (unidade de medida)
names(df_tratado)[names(df_tratado) == "VO2/Kg"] <- "VO2_kg"
names(df_tratado)[names(df_tratado) == "VCO2/Kg"] <- "VCO2_kg"
names(df_tratado)[names(df_tratado) == "VE/VO2"] <- "VE_VO2"
names(df_tratado)[names(df_tratado) == "VE/VCO2"] <- "VE_VCO2"
names(df_tratado)[names(df_tratado) == "Excesso.VCO2"] <- "Exc_CO2"
df_tratado$"Estágio" <- as_factor(df_tratado$"Estágio")
df_tratado$"velocidade" <- as_factor(df_tratado$"velocidade")
df_tratado$"VO2_kg" <- as.numeric(df_tratado$"VO2_kg")
df_tratado$"VCO2_kg" <- as.numeric(df_tratado$"VCO2_kg")
#df_tratado$"VO2_mL_min" <- as.numeric(df_tratado$"VO2_mL_min")
#df_tratado$"VCO2_mL_min" <- as.numeric(df_tratado$"VCO2_mL_min")
df_tratado$"VE_VO2" <- as.numeric(df_tratado$"VE_VO2")
df_tratado$"VE_VCO2" <- as.numeric(df_tratado$"VE_VCO2")
df_tratado$"Exc_CO2" <- as.numeric(df_tratado$"Exc_CO2")
df_tratado$"PetO2" <- as.numeric(df_tratado$"PetO2")
df_tratado <- filter(df_tratado, Estágio != "Aquecimento") #retira os valores de aquecimento
df_tratado <- filter(df_tratado, !is.na(Estágio)) #elimina os valores N/A
df_tratado <- filter(df_tratado, Estágio != 0) #elimina os valores N/A
df_tratado <- filter(df_tratado, !is.na(VO2_kg)) #elimina os valores N/A
df_tratado <- filter(df_tratado, !is.na(PSE)) #elimina os valores N/A
df_tratado$t <- as.numeric(df_tratado$t)
#Eliminação de artefatos - Analisar os dados e entender se algum range inferior e superior deve ser eliminado da amostra
df_tratado <- filter(df_tratado, VO2_kg >= 20) #elimina os valores de VO2_kg menores do que 20 (artefato)
df_tratado <- filter(df_tratado, VO2_kg <= 50) #elimina os valores de VO2_kg maiores do que 50 (artefato)
#Tratamento do tempo
start_time <- (530) #marcação do momento de início efetivo do teste no relógio do equipamento (em segundos)
df_tratado <- df_tratado %>% #convert time to seconds
mutate(
t = as.numeric(t),
# Create the new variable 't_s' by converting days to seconds (1 day = 86400 seconds)
t_s = t * 86400,
t_s = t_s - start_time # Subtract the start_time from the new t_s variable
)
#Eliminar dados dos primeiros 60s de teste
df_tratado <- filter(df_tratado, t_s >= 60)
head(df_tratado)
VO2pico <- (40.06)
LV1 <- (32.12)
LV2 <- (36.26)
#Preparando os dados
df_long_time <- df_tratado %>%
pivot_longer(cols = c("VO2_kg", "VCO2_kg"), names_to = "Variable", values_to = "Value")
ggplot(df_long_time, aes(x = t_s, y = Value, color = Variable)) +
geom_line(linewidth = 1) + # Use geom_line to create the curves
geom_hline(aes(yintercept = VO2pico), color = "green", linetype = "dashed", linewidth = 1) +
geom_hline(aes(yintercept = LV1), color = "blue", linetype = "dashed", linewidth = 1) +
geom_hline(aes(yintercept = LV2), color = "red", linetype = "dashed", linewidth = 1) +
labs(
x = "Time (seconds)",
y = "Gas Exchange Values (mL/min/kg)",
title = "VO2 and VCO2 Over Time",
subtitle = "Dashed lines: LV1 (blue), LV2 (red), and VO2pico (green)",
color = "Variable" # Title for the legend
) +
# You can manually set colors for a clearer plot
scale_color_manual(values = c("VO2_kg" = "blue", "VCO2_kg" = "red")) +
scale_y_continuous(breaks = c(20, 30, 35, 40, 50, 55, 60, LV1, LV2, VO2pico)) +
theme_bw()
df_aggregated <- df_tratado %>%
# Create a grouping variable based on 5-second intervals.
# The integer division (%/%) groups time points like 0-4.99s, 5-9.99s, etc.
mutate(time_group = floor(t_s / 5)) %>%
# Group the data by this new time group.
group_by(time_group) %>%
# Summarise each group by calculating the average of the key variables.
summarise(
# Use the first value of t_s for the new time variable, as it represents
# the start of the 5-second interval.
t_s = first(t_s),
VO2_kg_s = mean(VO2_kg, na.rm = TRUE),
VCO2_kg_s = mean(VCO2_kg, na.rm = TRUE),
VE_VCO2_s = mean(VE_VCO2, na.rm = TRUE),
VE_VO2_s = mean(VE_VO2, na.rm = TRUE)
) %>%
ungroup()
#Preparando os dados
df_long_time_s <- df_aggregated %>%
pivot_longer(cols = c("VO2_kg_s", "VCO2_kg_s"), names_to = "Variable", values_to = "Value")
ggplot(df_long_time_s, aes(x = t_s, y = Value, color = Variable)) +
geom_line(linewidth = 1) + # Use geom_line to create the curves
