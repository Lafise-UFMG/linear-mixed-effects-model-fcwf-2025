subtitle = "Dashed lines: LV1 (blue), LV2 (red), and VO2pico (green)"
) +
# Include the values of the variables on the x-axis
scale_x_continuous(breaks = c(20, 25, 30, 35, 45, 50, 55, 60, 65, LV1, LV2, VO2pico)) +
theme_bw()
