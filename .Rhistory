geom_vline(aes(xintercept = LV1), color = "blue", linetype = "dashed", linewidth = 1.1) +
geom_vline(aes(xintercept = LV2), color = "red", linetype = "dashed", linewidth = 1.1) +
labs(
x = "VO2",
y = "Ventilatory Equivalent (VE/VCO2)",
